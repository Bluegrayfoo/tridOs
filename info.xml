<?xml version="1.0" encoding="UTF-8"?>
<tlib version="1">
  <package name="tridos" version="0.1.0">
    <requires>
      <tool name="node"/>
    </requires>
    <commands>
      <!-- the build step sets up the Tricycle browser (npm packages and Chromium); it never fails the install -->
      <command name="tridos" build="node src/browser-setup.js --install" output="bin/tridos"/>
    </commands>
  </package>
</tlib>
