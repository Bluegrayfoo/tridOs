{
  "name": "tridos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TridOS: a fullscreen desktop for the terminal, drawn in block octant and sextant pixels",
  "bin": {
    "tridos": "bin/tridos"
  },
  "scripts": {
    "start": "node bin/tridos",
    "test": "node test/selftest.mjs && node test/apps.mjs",
    "browser:install": "playwright install chromium",
    "test:browser": "node test/browser.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0"
  }
}
